# Copy to .env.production on the server (never commit the real file) and fill in.
# Generate secrets with: openssl rand -hex 32

DOMAIN=nooi.ai
ACME_EMAIL=you@example.com

# Hex only: it is embedded in DATABASE_URL, so avoid URL-special characters.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

LOG_LEVEL=info
