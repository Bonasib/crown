# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ronda:ronda_dev_password@localhost:5432/ronda_ship

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-also-long-random

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3/Storage ────────────────────────────────────────────────────────────────
S3_BUCKET=rondaship-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ─── Apps ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── API Server ────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
LOG_LEVEL=info

# ─── Telegram Shop Bot (apps/telegram-bot, apps/shop-api, apps/shop-admin) ──────
# Never commit real values here — this file only documents placeholders.
# The shop domain uses its own database, separate from DATABASE_URL above.
SHOP_DATABASE_URL=postgresql://ronda:ronda_dev_password@localhost:5432/telegram_shop

# BotFather token for @digyourownwhole. Treat as a secret: rotate via
# @BotFather (/revoke) if it is ever exposed (e.g. pasted into chat/a ticket).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Admin panel auth (apps/shop-api). Generate a long random string.
ADMIN_JWT_SECRET=change-me-shop-admin-jwt-secret-min-32-chars

# Seed-only: initial admin panel login, created by `db:seed`. Change the
# password immediately after first login (Settings has no self-serve reset).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!

# apps/shop-api
SHOP_API_PORT=4100
SHOP_CORS_ORIGINS=http://localhost:3010

# apps/shop-admin
NEXT_PUBLIC_SHOP_API_URL=http://localhost:4100

# G2A Integration API — used only for opportunistic price/stock lookups on
# manually-added products (G2A's API is seller/listing-oriented, not a
# generic buy-and-resell endpoint). Safe to leave blank; the catalog works
# entirely from admin-entered price/stock without it.
# NOTE: G2A credentials are NOT read from env vars — set them in the running
# app via the admin panel (Settings page: "G2A Client/Key ID" and
# "G2A API Secret"), which stores them as ShopSetting rows (g2a_client_id,
# g2a_api_key) rather than in a checked-in file.
