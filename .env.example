# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ronda:ronda_dev_password@localhost:5432/ronda_ship

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-also-long-random

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3/Storage ────────────────────────────────────────────────────────────────
S3_BUCKET=rondaship-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ─── Apps ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── API Server ────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
LOG_LEVEL=info

# ─── Claude Agent / Composio ───────────────────────────────────────────────────
COMPOSIO_API_KEY=your-composio-api-key-here
COMPOSIO_USER_ID=ronda_dev
